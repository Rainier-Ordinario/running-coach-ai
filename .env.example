# Copy to .env (same folder) and fill in. Never commit .env.

# Garmin Connect login, used by POST /api/sync and the first /api/profile call.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Claude API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Claude model for the coach chat and Recovery Advisor.
# Leave blank to use the default (claude-opus-4-7).
CLAUDE_MODEL=
